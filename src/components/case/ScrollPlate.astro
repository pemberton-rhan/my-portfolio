---
// Plate 1: the project's full page in a frame that scrolls itself (see scripts/case-study.js).
interface Props { image: { src: string; width: number; height: number; alt: string } }
const { image } = Astro.props;
---
<figure class="cs-plate cs-scroll fx"><div class="ph has-img cs-scroll-f" tabindex="0" role="img" aria-label={image.alt}><img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" /></div>
   <figcaption><span><b>Plate 1</b> The full landing page, top to bottom.</span><span class="cs-scroll-hint">Hover to scroll</span></figcaption></figure>

<style>
  .cs-plate .ph.cs-scroll-f {
    aspect-ratio: auto;
    height: min(720px,72vh);
    overflow: hidden;
    background: #fff;
    outline: none;
  }
  .cs-plate .ph.cs-scroll-f img {
    inset: auto;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    object-fit: fill;
    transform: translate3d(0,var(--y,0px),0);
    transition: transform var(--dur,1.2s) cubic-bezier(.45,.05,.55,.95);
    will-change: transform;
  }
  .cs-plate .ph.cs-scroll-f:focus-visible {
    box-shadow: 0 0 0 2px var(--paper);
  }
  .cs-scroll figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .cs-scroll-hint {
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cs-scroll.is-manual .cs-scroll-f {
    overflow-y: auto;
  }
  .cs-scroll.is-manual .cs-scroll-f img {
    position: static;
    transform: none;
    transition: none;
  }
  @media (max-width:760px) {
    .cs-plate .ph.cs-scroll-f {
      height: min(560px,70vh);
    }
    .cs-scroll figcaption {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
