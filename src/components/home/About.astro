---
import { companies } from '../../data/companies';
const facts = [
  { label: 'Served', value: 'Hospital Corpsman', note: 'US Navy' },
  { label: 'Trained', value: 'Graphic and web design', note: 'Platt College, San Diego, CA' },
  { label: 'Built', value: 'WordPress since 2013', note: 'iLawyer, LawRank, GoFundMe' },
  { label: 'Leader', value: 'Mentoring and code review', note: 'GoFundMe, Elite Legal Marketing' },
];
// The tape holds the logos twice so the loop is seamless; the copy is hidden from screen readers.
const tape = [...companies.map((c) => ({ ...c, copy: false })), ...companies.map((c) => ({ ...c, copy: true }))];
---
<section class="about about--rev" id="about"><div class="max sheet">
 <div class="rail"><span>About</span></div>
 <div class="bio">
  <h2>A designer’s eye, an engineer’s habits, a lead’s patience.</h2>
  <p class="prose">I came to the web through design. After serving as a hospital corpsman in the US Navy, I worked as a graphic and web designer before moving into WordPress engineering full time in 2013.</p>
  <p class="prose">Since then I’ve built and run sites for law firms, agencies and GoFundMe, and spent the last several years leading the engineers who build them: setting standards, reviewing code, and turning good habits into process that a whole team can follow.</p>
 </div>
 <div class="facts">
  <div class="path">
   {facts.map((f) => <div><p class="lab">{f.label}</p><p class="val">{f.value}<small>{f.note}</small></p></div>)}
  </div></div>
 <div class="rail rail--logos"><span>Companies</span></div><div class="logos"><p class="lab">Companies</p><div class="ticker"><ul class="tape">{tape.map((c) => <li aria-hidden={c.copy ? 'true' : undefined}><img src={`/logos/${c.file}`} alt={c.copy ? '' : c.name} style={`--h:${c.height}px`} loading="lazy" /></li>)}</ul></div></div>
</div></section>

<style>
  .about {
    background: var(--paper);
    overflow-x: clip;
  }
  .bio {
    grid-column: 7/span 7;
    padding: var(--sec) var(--pad) var(--sec);
    background: var(--v) left top/1px 100% no-repeat;
  }
  .bio h2 {
    font-family: "Instrument Sans";
    font-weight: 500;
    font-size: 44px;
    line-height: 50px;
    letter-spacing: -.02em;
    margin: 18px 0 0;
    max-width: 13em;
  }
  .bio .prose {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 30px;
    color: var(--ink);
    max-width: 34em;
    margin-top: 28px;
  }
  .bio .prose+.prose {
    margin-top: 18px;
    color: var(--ink-muted);
  }
  .path {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 48px;
    background: var(--h) left top/100% 1px no-repeat;
  }
  .path div {
    padding: 18px 24px 20px 0;
    background: var(--h) left bottom/100% 1px no-repeat;
  }
  .path div:nth-child(even) {
    padding-left: 24px;
    background: var(--h) left bottom/100% 1px no-repeat,var(--v) left top/1px 100% no-repeat;
  }
  .path .val {
    font-size: 15px;
    line-height: 22px;
    margin-top: 8px;
  }
  .path .val small {
    display: block;
    color: var(--ink-muted);
    font-size: 13px;
    line-height: 20px;
  }
  @media (max-width:1100px) {
    .bio {
      grid-column: 2/span 12;
      background: none;
    }
  }
  @media (max-width:760px) {
    .bio {
      grid-column: 1/-1;
      padding-left: 20px;
      padding-right: 20px;
      padding-top: 40px;
    }
    .bio h2 {
      font-size: 32px;
      line-height: 38px;
    }
    .bio .prose {
      font-size: 16px;
      line-height: 27px;
    }
    .path {
      grid-template-columns: 1fr;
    }
    .path div:nth-child(even) {
      padding-left: 0;
      background: var(--h) left bottom/100% 1px no-repeat;
    }
  }
  .about .rail {
    grid-row: 1/span 2;
  }
  @media (max-width:1100px) {
    .about .rail {
      grid-row: 1/span 3;
    }
  }
  .bio h2 {
    margin-top: 0;
  }
  .about .rail:not(.rail--logos) {
    grid-row: 1;
  }
  .about .rail--logos {
    grid-row: 2;
    grid-column: 1;
  }
  .about .rail--logos span {
    position: static;
    margin: 56px 0 56px 14px;
  }
  @media (max-width:1100px) {
    .about .rail:not(.rail--logos) {
      grid-row: 1/span 2;
    }
    .about .rail--logos {
      grid-row: 3;
    }
  }
  @media (max-width:760px) {
    .path {
      background: none;
    }
    .path div:last-child {
      background: none;
    }
  }
  @media (min-width:1101px) {
    .about--rev .bio {
      grid-column: 2/span 7;
      grid-row: 1;
      background: none;
    }
  }
  .about .facts {
    grid-column: 9/span 5;
    grid-row: 1;
    padding: var(--sec) var(--pad);
    background: var(--v) left top/1px 100% no-repeat;
  }
  .about .facts .path {
    grid-template-columns: 1fr;
    margin-top: 0;
    background: none;
  }
  .about .facts .path div,
  .about .facts .path div:nth-child(even) {
    padding: 22px 0 24px;
    background: var(--h) left bottom/100% 1px no-repeat;
  }
  .about .facts .path div:first-child {
    padding-top: 6px;
  }
  .about .facts .path div:last-child {
    background: none;
    padding-bottom: 0;
  }
  @media (max-width:1100px) {
    .about--rev .bio {
      grid-column: 2/span 12;
      padding-bottom: 0;
    }
    .about .facts {
      grid-column: 2/span 12;
      grid-row: 2;
      padding-top: 48px;
      background: none;
    }
    .about .facts .path {
      grid-template-columns: 1fr 1fr;
      background: var(--h) left top/100% 1px no-repeat;
    }
    .about .facts .path div,
    .about .facts .path div:first-child {
      padding: 18px 24px 20px 0;
      background: var(--h) left bottom/100% 1px no-repeat;
    }
    .about .facts .path div:nth-child(even) {
      padding: 18px 0 20px 24px;
      background: var(--h) left bottom/100% 1px no-repeat,var(--v) left top/1px 100% no-repeat;
    }
    .about .facts .path div:last-child {
      padding-bottom: 20px;
    }
  }
  @media (max-width:760px) {
    .about--rev .bio {
      grid-column: 1/-1;
    }
    .about .facts {
      grid-column: 1/-1;
      padding: 32px 20px 48px;
    }
    .about .facts .path {
      grid-template-columns: 1fr;
      background: none;
    }
    .about .facts .path div,
    .about .facts .path div:first-child,
    .about .facts .path div:nth-child(even) {
      padding: 16px 0 18px;
      background: var(--h) left bottom/100% 1px no-repeat;
    }
    .about .facts .path div:first-child {
      padding-top: 0;
    }
    .about .facts .path div:last-child {
      background: none;
      padding-bottom: 0;
    }
  }
  .logos {
    position: relative;
    display: grid;
  }
  .logos:before {
    content: "";
    position: absolute;
    left: -100vw;
    right: -100vw;
    top: 0;
    height: 1px;
    background: var(--h) left top/100% 1px no-repeat;
  }
  .logos .lab {
    padding: 36px var(--pad);
    margin: 0;
  }
  .logos ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
  }
  .logos li {
    display: grid;
    place-items: center;
    background: var(--v) left top/1px 100% no-repeat;
    text-align: center;
    min-height: 120px;
  }
  .logos img {
    display: block;
    opacity: .85;
  }
  @media (max-width:1100px) {
    .logos .lab {
      padding: 32px var(--pad) 8px;
    }
    .logos li:nth-child(n+4) {
      box-shadow: inset 0 1px 0 rgba(51,63,85,.3);
    }
    .logos li:nth-child(3n+1) {
      background: none;
    }
  }
  .logos li {
    padding: 28px 24px;
  }
  .logos li:nth-child(n+5) {
    box-shadow: inset 0 1px 0 rgba(51,63,85,.25);
  }
  .logos img {
    height: var(--h);
    width: auto;
    max-width: 100%;
  }
  @media (max-width:1100px) {
    .logos ul {
      grid-template-columns: repeat(4,minmax(0,1fr));
    }
    .logos li:nth-child(n) {
      background: var(--v) left top/1px 100% no-repeat;
      box-shadow: none;
    }
    .logos li:nth-child(4n+1) {
      background: none;
    }
    .logos li:nth-child(n+5) {
      box-shadow: inset 0 1px 0 rgba(51,63,85,.25);
    }
    .logos img {
      height: calc(var(--h)*.85);
    }
  }
  @media (max-width:760px) {
    .logos ul {
      grid-template-columns: 1fr 1fr;
    }
    .logos li {
      min-height: 92px;
      padding: 20px 16px;
    }
    .logos li:nth-child(n) {
      background: var(--v) left top/1px 100% no-repeat;
      box-shadow: inset 0 1px 0 rgba(51,63,85,.25);
    }
    .logos li:nth-child(odd) {
      background: none;
    }
    .logos img {
      height: calc(var(--h)*.8);
    }
  }
  .ticker {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }
  .logos .tape {
    display: flex;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: tape 48s linear infinite;
    grid-template-columns: none;
  }
  .logos .tape li,
  .logos .tape li:nth-child(n) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 56px;
    background: none;
    box-shadow: none;
    flex: none;
  }
  .logos .tape li+li:nth-child(n) {
    background: var(--v) left center/1px 40px no-repeat;
  }
  .logos .tape img {
    height: var(--h);
    width: auto;
    max-width: none;
    opacity: .85;
  }
  .ticker:hover .tape {
    animation-play-state: paused;
  }
  @keyframes tape {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion:reduce) {
    .logos .tape {
      animation: none;
    }
    .ticker {
      overflow-x: auto;
    }
  }
  @media (max-width:1100px) {
    .logos {
      grid-template-columns: 1fr;
    }
    .ticker {
      background: none;
    }
    .logos .tape li,
    .logos .tape li:nth-child(n) {
      padding: 0 44px;
    }
    .logos .tape li+li:nth-child(n) {
      background: var(--v) left center/1px 36px no-repeat;
    }
    .logos .tape img {
      height: calc(var(--h)*.9);
    }
  }
  @media (max-width:760px) {
    .logos .tape {
      animation-duration: 36s;
    }
    .logos .tape li,
    .logos .tape li:nth-child(n) {
      padding: 0 32px;
    }
    .logos .tape img {
      height: calc(var(--h)*.8);
    }
    .ticker {
      -webkit-mask-image: linear-gradient(90deg,transparent 0,#000 32px,#000 calc(100% - 32px),transparent 100%);
      mask-image: linear-gradient(90deg,transparent 0,#000 32px,#000 calc(100% - 32px),transparent 100%);
    }
  }
  .logos .lab {
    align-self: stretch;
    align-items: center;
    background: var(--v) right top/1px 100% no-repeat;
  }
  @media (max-width:1100px) {
    .logos .lab {
      background: none;
    }
  }
  @media (max-width:760px) {
    .logos .lab {
      padding-bottom: 4px;
      padding: 32px 20px 4px;
      white-space: nowrap;
    }
  }
  .logos {
    grid-column: 2/span 12;
    grid-row: 2;
    grid-template-columns: 1fr;
  }
  .logos .lab {
    display: none;
  }
  .ticker {
    -webkit-mask-image: linear-gradient(90deg,transparent 0,#000 48px,#000 calc(100% - 72px),transparent 100%);
    mask-image: linear-gradient(90deg,transparent 0,#000 48px,#000 calc(100% - 72px),transparent 100%);
  }
  @media (max-width:1100px) {
    .logos {
      grid-row: 3;
    }
  }
  @media (max-width:760px) {
    .logos {
      grid-column: 1/-1;
    }
    .logos .lab {
      display: block;
    }
  }
  .logos .tape li,
  .logos .tape li:nth-child(n) {
    min-height: 188px;
  }
  @media (max-width:1100px) {
    .logos .tape li,
    .logos .tape li:nth-child(n) {
      min-height: 188px;
    }
  }
  @media (max-width:760px) {
    .logos .tape li,
    .logos .tape li:nth-child(n) {
      min-height: 96px;
    }
  }
</style>
